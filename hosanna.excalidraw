      "customData": {
        "generationData": {
          "status": "done",
          "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modern Backend Stack | Server, Redis, Prisma, PostgreSQL</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://unpkg.com/lucide@latest\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #09090b;\n            color: #fafafa;\n        }\n        .glass {\n            background: rgba(24, 24, 27, 0.8);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(63, 63, 70, 0.4);\n        }\n        .glow {\n            box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);\n        }\n        .gradient-text {\n            background: linear-gradient(to right, #60a5fa, #a78bfa);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n    </style>\n</head>\n<body class=\"antialiased selection:bg-indigo-500/30\">\n\n    <!-- Navigation -->\n    <header class=\"fixed top-0 w-full z-50 glass border-b border-zinc-800\">\n        <nav class=\"max-w-7xl mx-auto px-4 h-16 flex items-center justify-between\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center\">\n                    <i data-lucide=\"layers\" class=\"w-5 h-5 text-white\"></i>\n                </div>\n                <span class=\"font-bold text-xl tracking-tight\">StackCore</span>\n            </div>\n            <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400\">\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Architecture</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Documentation</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Benchmarks</a>\n            </div>\n            <div class=\"flex items-center gap-4\">\n                <button class=\"text-sm font-medium hover:text-white transition-colors\">Log in</button>\n                <button class=\"bg-white text-black px-4 py-2 rounded-md text-sm font-semibold hover:bg-zinc-200 transition-all\">\n                    Get Started\n                </button>\n            </div>\n        </nav>\n    </header>\n\n    <main class=\"pt-32 pb-20\">\n        <!-- Hero Section -->\n        <section class=\"max-w-7xl mx-auto px-4 text-center mb-24\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-medium text-indigo-400 mb-6\">\n                <span class=\"relative flex h-2 w-2\">\n                    <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75\"></span>\n                    <span class=\"relative inline-flex rounded-full h-2 w-2 bg-indigo-500\"></span>\n                </span>\n                Production Ready Architecture\n            </div>\n            <h1 class=\"text-5xl md:text-7xl font-extrabold mb-6 tracking-tight\">\n                Modern <span class=\"gradient-text\">Backend</span> Infrastructure.\n            </h1>\n            <p class=\"text-zinc-400 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed\">\n                A high-performance foundation built with Node.js, Redis caching, Prisma ORM, and PostgreSQL. Scalable by design, type-safe by default.\n            </p>\n            <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n                <button class=\"w-full sm:w-auto px-8 py-4 bg-indigo-600 hover:bg-indigo-500 rounded-xl font-bold transition-all transform hover:-translate-y-1 glow\">\n                    Deploy to Cloud\n                </button>\n                <button class=\"w-full sm:w-auto px-8 py-4 bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 rounded-xl font-bold transition-all\">\n                    View Templates\n                </button>\n            </div>\n        </section>\n\n        <!-- Tech Stack Grid -->\n        <section class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n                \n                <!-- Server Card -->\n                <div class=\"glass p-8 rounded-2xl group hover:border-indigo-500/50 transition-all\">\n                    <div class=\"w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\">\n                        <i data-lucide=\"server\" class=\"text-blue-500\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Core Server</h3>\n                    <p class=\"text-zinc-400 text-sm leading-relaxed mb-4\">\n                        Optimized Node.js runtime with Express/Fastify for low-latency request handling and middleware support.\n                    </p>\n                    <div class=\"text-xs font-mono text-zinc-500 bg-black/40 p-2 rounded\">v20.x LTS</div>\n                </div>\n\n                <!-- Redis Card -->\n                <div class=\"glass p-8 rounded-2xl group hover:border-red-500/50 transition-all\">\n                    <div class=\"w-12 h-12 bg-red-500/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\">\n                        <i data-lucide=\"zap\" class=\"text-red-500\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Redis Cache</h3>\n                    <p class=\"text-zinc-400 text-sm leading-relaxed mb-4\">\n                        Blazing fast in-memory data store for session management, rate limiting, and real-time pub/sub.\n                    </p>\n                    <div class=\"text-xs font-mono text-zinc-500 bg-black/40 p-2 rounded\">Sub-ms Latency</div>\n                </div>\n\n                <!-- Prisma Card -->\n                <div class=\"glass p-8 rounded-2xl group hover:border-emerald-500/50 transition-all\">\n                    <div class=\"w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\">\n                        <i data-lucide=\"database\" class=\"text-emerald-500\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Prisma ORM</h3>\n                    <p class=\"text-zinc-400 text-sm leading-relaxed mb-4\">\n                        Next-generation Node.js and TypeScript ORM. Automated migrations and type-safe database access.\n                    </p>\n                    <div class=\"text-xs font-mono text-zinc-500 bg-black/40 p-2 rounded\">Auto-generated Types</div>\n                </div>\n\n                <!-- PostgreSQL Card -->\n                <div class=\"glass p-8 rounded-2xl group hover:border-sky-500/50 transition-all\">\n                    <div class=\"w-12 h-12 bg-sky-500/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\">\n                        <i data-lucide=\"hard-drive\" class=\"text-sky-500\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">PostgreSQL</h3>\n                    <p class=\"text-zinc-400 text-sm leading-relaxed mb-4\">\n                        The world's most advanced open source relational database for reliable and complex data persistence.\n                    </p>\n                    <div class=\"text-xs font-mono text-zinc-500 bg-black/40 p-2 rounded\">ACID Compliant</div>\n                </div>\n\n            </div>\n        </section>\n\n        <!-- Code Preview Section -->\n        <section class=\"max-w-5xl mx-auto px-4 mt-32\">\n            <div class=\"glass rounded-2xl overflow-hidden shadow-2xl\">\n                <div class=\"bg-zinc-800/50 px-4 py-3 flex items-center gap-2 border-b border-zinc-700\">\n                    <div class=\"flex gap-1.5\">\n                        <div class=\"w-3 h-3 rounded-full bg-red-500/50\"></div>\n                        <div class=\"w-3 h-3 rounded-full bg-yellow-500/50\"></div>\n                        <div class=\"w-3 h-3 rounded-full bg-green-500/50\"></div>\n                    </div>\n                    <span class=\"text-xs text-zinc-500 font-mono ml-4\">schema.prisma</span>\n                </div>\n                <div class=\"p-6 font-mono text-sm overflow-x-auto\">\n                    <pre class=\"text-indigo-300\">\n<span class=\"text-zinc-500\">// Define your database schema</span>\ndatasource db {\n  provider = <span class=\"text-emerald-400\">\"postgresql\"</span>\n  url      = env(<span class=\"text-emerald-400\">\"DATABASE_URL\"</span>)\n}\n\ngenerator client {\n  provider = <span class=\"text-emerald-400\">\"prisma-client-js\"</span>\n}\n\nmodel User {\n  id    Int     @id @default(autoincrement())\n  email String  @unique\n  name  String?\n  posts Post[]\n}</pre>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <footer class=\"border-t border-zinc-800 py-12 bg-zinc-950\">\n        <div class=\"max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-8\">\n            <div class=\"flex items-center gap-2 opacity-50\">\n                <i data-lucide=\"layers\" class=\"w-5 h-5\"></i>\n                <span class=\"font-bold\">StackCore</span>\n            </div>\n            <p class=\"text-zinc-500 text-sm\">\n                &copy; 2023 StackCore Systems. Built for developers.\n            </p>\n            <div class=\"flex gap-6\">\n                <a href=\"#\" class=\"text-zinc-500 hover:text-white transition-colors\"><i data-lucide=\"github\"></i></a>\n                <a href=\"#\" class=\"text-zinc-500 hover:text-white transition-colors\"><i data-lucide=\"twitter\"></i></a>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Initialize Lucide icons\n        lucide.createIcons();\n    </script>\n</body>\n</html>"
        }
      }
    },
